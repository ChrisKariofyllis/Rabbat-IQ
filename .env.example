# Markthunter reads deployment settings from the environment.
# Shopping interests, postal code, AI keys, and Telegram live in the web UI
# (stored in the local SQLite database). Values below are optional overrides.

# Bind address inside the process. Docker already publishes the port.
MARKTHUNTER_HOST=0.0.0.0
MARKTHUNTER_PORT=8000

# SQLite file. Use four slashes for an absolute path.
MARKTHUNTER_DATABASE_URL=sqlite:///./data/markthunter.db
MARKTHUNTER_DATA_DIR=./data
MARKTHUNTER_LOG_LEVEL=INFO

# Set both to require a password on the web UI. Leave empty on localhost.
MARKTHUNTER_BASIC_AUTH_USER=
MARKTHUNTER_BASIC_AUTH_PASSWORD=

# Optional Marktguru keys. When empty, Markthunter reads the public web
# client's keys from marktguru.de / marktguru.at and caches them locally.
MARKTHUNTER_MARKTGURU_API_KEY=
MARKTHUNTER_MARKTGURU_CLIENT_KEY=

# Optional first-run seed. Applied only when the database is created.
MARKTHUNTER_POSTAL_CODE=
MARKTHUNTER_COUNTRY=de

# Used by tests and local debugging. Leave unset in normal use.
MARKTHUNTER_DISABLE_SCHEDULER=0
MARKTHUNTER_DISABLE_BOT=0
